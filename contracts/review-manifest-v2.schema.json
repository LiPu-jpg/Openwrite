{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwrite.dev/schemas/review-manifest-v2.schema.json",
  "title": "dsh-novel review manifest v2",
  "type": "object",
  "required": ["schemaVersion", "recordType", "chapterId", "verdict"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {"const": "dsh-novel.review.manifest.v2"},
    "recordType": {"const": "review"},
    "chapterId": {"type": "string", "pattern": "^ch_\\d+$"},
    "verdict": {"enum": ["pass", "fail", "inconclusive"]},
    "decisionSource": {"enum": ["v2", "v1-adapter"]},
    "threshold": {"type": "integer", "minimum": 0, "maximum": 100},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "qualityScore": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
  }
}
