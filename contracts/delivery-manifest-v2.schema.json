{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwrite.dev/schemas/delivery-manifest-v2.schema.json",
  "title": "dsh-novel delivery manifest v2",
  "type": "object",
  "required": ["schemaVersion", "recordType", "chapterId", "stages"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {"const": "dsh-novel.delivery.manifest.v2"},
    "recordType": {"const": "chapter-delivery"},
    "chapterId": {"type": "string", "pattern": "^ch_\\d+$"},
    "novelId": {"type": "string", "minLength": 1},
    "threshold": {"type": "integer", "minimum": 0, "maximum": 100},
    "decisionSource": {"enum": ["v2", "v1-adapter"]},
    "readyForDelivery": {"type": "boolean"},
    "stages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["schemaVersion", "recordType", "chapterId", "stage", "verdict", "status", "evidence"],
        "additionalProperties": true,
        "properties": {
          "schemaVersion": {"const": "dsh-novel.delivery.stage.v2"},
          "recordType": {"const": "delivery-stage"},
          "chapterId": {"type": "string", "pattern": "^ch_\\d+$"},
          "stage": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["pass", "fail", "inconclusive"]},
          "status": {"type": "string", "minLength": 1},
          "evidence": {"type": "object"}
        }
      }
    }
  }
}
