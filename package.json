{
  "name": "dsh-novel",
  "version": "0.1.0",
  "private": true,
  "description": "OpenWrite 长篇小说领域后端接入 DeepSeek Harness：双 agent 预设 + 原生创作工作台",
  "type": "module",
  "scripts": {
    "build": "npm --prefix packages/openwrite-bridge run build && npm --prefix packages/studio-panel run build",
    "test:dog": "npm --prefix packages/openwrite-bridge run build && .venv/bin/python conductor/test_dog_artifacts.py",
    "test:epochs": "npm --prefix packages/studio-panel run test:epochs",
    "test:contracts": "npm --prefix packages/openwrite-bridge run test:contracts",
    "install-dsh": "bash scripts/install.sh",
    "dev": "bash scripts/dev.sh"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@deepseek-ai/dsh": "^0.1.0-rc.7"
  }
}
